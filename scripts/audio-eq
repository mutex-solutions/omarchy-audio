#!/usr/bin/env bash
#
# Parametric headphone EQ for PipeWire, hosted in its own filter-chain client.
#
#   audio-eq status
#   audio-eq list
#   audio-eq apply <profile|url> [--preamp dB] [--gains "g1,g2,..."]
#   audio-eq on | off | toggle
#   audio-eq import <url|path> [name]
#   audio-eq search <query>
#   audio-eq sources
#   audio-eq source-add <github|json|folder> <target> [name]
#   audio-eq source-remove <id> | source-enable <id> on|off | source-refresh [id]
#
# One JSON object on stdout. Profiles are AutoEQ ParametricEQ.txt files or the
# built-in presets in ~/.config/deck/eq/profiles.
#
# The graph is hosted by `pipewire -c deck-eq.conf` in a user service, the same
# shape Omarchy uses for its speaker tuning: a dedicated client means the EQ can
# be started and stopped without restarting pipewire-pulse (which drops every
# PulseAudio client, including ones like Spotify that do not reconnect).

set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONF_DIR="$CONFIG_HOME/pipewire"
HOST_CONF="$CONF_DIR/deck-eq.conf"
FRAG_DIR="$CONF_DIR/deck-eq.conf.d"
FRAG="$FRAG_DIR/90-eq.conf"
HOST_SRC="/usr/share/omarchy/default/audio/filter-chain-host.conf"
UNIT_DIR="$CONFIG_HOME/systemd/user"
UNIT="$UNIT_DIR/deck-eq.service"
STATE_DIR="$STATE_HOME/deck"
STATE="$STATE_DIR/eq.json"
PROFILE_DIR="$CONFIG_HOME/deck/eq/profiles"
INDEX_DIR="$CACHE_HOME/deck/eq-index"
SOURCES="$CONFIG_HOME/deck/eq/sources.json"
SINK="deck_eq"
OUTPUT="deck_eq_output"
SERVICE="deck-eq.service"

AUTOEQ_RAW="https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/"

fail() {
  jq -nc --arg error "$1" '{ok:false,error:$error}' 2>/dev/null \
    || printf '{"ok":false,"error":"%s"}\n' "$1"
  exit 1
}

need() { command -v "$1" >/dev/null 2>&1 || fail "$1 is required"; }
need jq; need pactl; need systemctl; need awk; need curl

mkdir -p "$PROFILE_DIR" "$STATE_DIR" "$FRAG_DIR" "$UNIT_DIR"

init_builtins() {
  local f="$PROFILE_DIR/Flat.txt"
  [[ -f $f ]] || cat > "$f" <<'P'
Preamp: 0.0 dB
Filter 1: ON PK Fc 1000 Hz Gain 0.0 dB Q 0.70
P
  f="$PROFILE_DIR/Bass Boost.txt"
  [[ -f $f ]] || cat > "$f" <<'P'
Preamp: -5.0 dB
Filter 1: ON LS Fc 105 Hz Gain 6.0 dB Q 0.70
Filter 2: ON PK Fc 60 Hz Gain 3.0 dB Q 1.00
Filter 3: ON PK Fc 200 Hz Gain -1.5 dB Q 0.90
P
  f="$PROFILE_DIR/Vocal.txt"
  [[ -f $f ]] || cat > "$f" <<'P'
Preamp: -3.0 dB
Filter 1: ON PK Fc 250 Hz Gain -2.5 dB Q 1.00
Filter 2: ON PK Fc 3000 Hz Gain 3.0 dB Q 0.90
Filter 3: ON HS Fc 8000 Hz Gain -1.0 dB Q 0.70
P
  f="$PROFILE_DIR/Treble.txt"
  [[ -f $f ]] || cat > "$f" <<'P'
Preamp: -4.0 dB
Filter 1: ON HS Fc 6000 Hz Gain 4.0 dB Q 0.70
Filter 2: ON PK Fc 10000 Hz Gain 2.0 dB Q 0.90
P
}
init_builtins

name_of() { basename "$1" .txt; }

# ---------------------------------------------------------------- sources
# A source is somewhere profiles can be found. Three kinds:
#   github  owner/repo[@branch] laid out like AutoEq: results/INDEX.md plus
#           results/<provider>/<category>/<name>/<name> ParametricEQ.txt.
#           Upstream AutoEq is one of these and already carries about twenty
#           providers (crinacle, oratory1990, Rtings, ...), so the provider is
#           read from the path, not from the source.
#   json    an address returning [{name, url, provider?, category?}]
#   folder  a directory of ParametricEQ.txt files on this machine
save_sources() { printf '%s\n' "$1" > "$SOURCES.tmp" && mv "$SOURCES.tmp" "$SOURCES"; }

ensure_sources() {
  mkdir -p "$(dirname "$SOURCES")"
  if [[ ! -s $SOURCES ]] || ! jq -e 'type == "array"' "$SOURCES" >/dev/null 2>&1; then
    save_sources '[{"id":"autoeq","name":"AutoEq","kind":"github","target":"jaakkopasanen/AutoEq@master","enabled":true,"builtin":true}]'
  fi
}

sources_json() {
  local idx
  idx="$(for f in "$INDEX_DIR"/*.json; do
      [[ -s $f ]] || continue
      printf '%s\t%s\t%s\n' "$(basename "$f" .json)" "$(jq 'length' "$f" 2>/dev/null || echo 0)" "$(date -r "$f" +%s)"
    done | jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t")
        | {key: .[0], value: {count: (.[1]|tonumber), updated: (.[2]|tonumber)}}) | from_entries')"
  [[ -n $idx ]] || idx="{}"
  jq -c --argjson idx "$idx" '{ok:true, sources: map(. + ($idx[.id] // {count:0, updated:0}))}' "$SOURCES"
}

# Writes $INDEX_DIR/<id>.json: [{name, provider, category, url, source, sourceName}]
build_index() {
  local id="$1" kind target name repo branch out tmp
  mkdir -p "$INDEX_DIR"
  kind="$(jq -r --arg id "$id" '.[]|select(.id==$id)|.kind' "$SOURCES")"
  target="$(jq -r --arg id "$id" '.[]|select(.id==$id)|.target' "$SOURCES")"
  name="$(jq -r --arg id "$id" '.[]|select(.id==$id)|.name' "$SOURCES")"
  [[ -n $kind ]] || { echo "no source named $id" >&2; return 1; }
  out="$INDEX_DIR/$id.json"; tmp="$(mktemp)"
  case "$kind" in
    github)
      repo="${target%%@*}"; branch="master"; [[ $target == *@* ]] && branch="${target#*@}"
      local base="https://raw.githubusercontent.com/$repo/$branch/"
      curl -fsL --max-time 60 "${base}results/INDEX.md" -o "$tmp.md" \
        || { rm -f "$tmp" "$tmp.md"; echo "could not read ${base}results/INDEX.md" >&2; return 1; }
      # "- [Name](./provider/category/Name) by provider ..." -> name, path
      awk -F'\\]\\(\\./' '/^- \[/ {
        n=$1; sub(/^- \[/, "", n); p=$2
        if (!sub(/\) by [^)]*$/, "", p)) sub(/\)$/, "", p)
        if (n != "" && p != "") printf "%s\t%s\n", n, p }' "$tmp.md" > "$tmp.tsv"
      jq -R -s -c --arg base "$base" --arg id "$id" --arg sn "$name" '
        split("\n") | map(select(length > 0) | split("\t") | . as $r
          | ($r[1] | split("/")) as $p
          | select($p | length >= 2)
          | {name: $r[0],
             provider: ($p[0] | gsub("%20"; " ")),
             category: ($p[1] | gsub("%20"; " ")),
             url: ($base + "results/" + $r[1] + "/" + $p[-1] + "%20ParametricEQ.txt"),
             source: $id, sourceName: $sn})
        | unique_by(.url)' "$tmp.tsv" > "$tmp" || { rm -f "$tmp" "$tmp.md" "$tmp.tsv"; echo "could not build the index" >&2; return 1; }
      rm -f "$tmp.md" "$tmp.tsv" ;;
    json)
      curl -fsL --max-time 60 "$target" -o "$tmp.raw" \
        || { rm -f "$tmp" "$tmp.raw"; echo "could not download $target" >&2; return 1; }
      jq -c --arg id "$id" --arg sn "$name" '
        (if type == "array" then . else (.profiles // .results // []) end)
        | map(select(type == "object" and (.name|type) == "string" and (.url|type) == "string")
          | {name, provider: (.provider // .source // $sn), category: (.category // ""), url,
             source: $id, sourceName: $sn})' "$tmp.raw" > "$tmp" \
        || { rm -f "$tmp" "$tmp.raw"; echo "that address did not return a list of profiles" >&2; return 1; }
      rm -f "$tmp.raw" ;;
    folder)
      find "$target" -type f -iname '*.txt' -print0 2>/dev/null \
        | xargs -0 -r grep -l '^Filter' 2>/dev/null \
        | jq -R -s -c --arg root "$target" --arg id "$id" --arg sn "$name" '
            split("\n") | map(select(length > 0)
              | (sub("^" + $root + "/?"; "") | split("/")) as $p
              | {name: ($p[-1] | sub(" ?ParametricEQ"; "") | sub("\\.txt$"; "")),
                 provider: $sn, category: (if ($p|length) > 1 then $p[:-1]|join("/") else "" end),
                 url: ($root + "/" + ($p|join("/"))), source: $id, sourceName: $sn})' > "$tmp" \
        || { rm -f "$tmp"; echo "could not read that folder" >&2; return 1; } ;;
  esac
  if [[ $(jq 'length' "$tmp" 2>/dev/null || echo 0) -eq 0 ]]; then
    rm -f "$tmp"; echo "that source has no profiles I can read" >&2; return 1
  fi
  mv "$tmp" "$out"
}

# AutoEQ ParametricEQ.txt -> {name, preamp, bands:[{type,fc,gain,q}]}
parse_profile() {
  local file="$1" name="$2"
  [[ -r $file ]] || fail "no such profile: $file"
  local pre
  pre="$(awk '/^Preamp:/ {print $2; found=1; exit} END {if (!found) print 0}' "$file")"
  [[ -n $pre ]] || pre=0
  local rows
  rows="$(awk '
    /^Filter/ {
      if ($3 != "ON") next
      type=$4
      label=""
      if (type ~ /^PK/) label="PK"
      else if (type ~ /^LS/) label="LS"
      else if (type ~ /^HS/) label="HS"
      else next
      fc=$6; gain=$9; q=$12
      if (q == "") q=0.707
      printf "%s\t%s\t%s\t%s\n", label, fc, gain, q
    }' "$file")"
  jq -nc --arg name "$name" --argjson pre "$pre" --arg rows "$rows" '
    {name:$name, preamp:$pre,
     bands: ($rows | split("\n") | map(select(length > 0) | split("\t")
       | {type: .[0], fc: (.[1]|tonumber), gain: (.[2]|tonumber), q: (.[3]|tonumber)}))}'
}

render_fragment() {
  local json="$1" target="$2" out="$3"
  local pre bands n
  pre="$(jq -r '.preamp' <<< "$json")"
  n="$(jq '.bands | length' <<< "$json")"

  {
    cat <<H
context.modules = [
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "Headphone EQ"
      media.name       = "Headphone EQ"

      filter.graph = {
        nodes = [
          { type = builtin name = pre_l label = bq_highshelf control = { "Freq" = 1 "Q" = 0.707 "Gain" = $pre } }
          { type = builtin name = pre_r label = bq_highshelf control = { "Freq" = 1 "Q" = 0.707 "Gain" = $pre } }
H
    local i=0
    while IFS=$'\t' read -r type fc gain q; do
      local label
      case "$type" in
        PK) label=bq_peaking ;;
        LS) label=bq_lowshelf ;;
        HS) label=bq_highshelf ;;
      esac
      printf '          { type = builtin name = b%d_l label = %s control = { "Freq" = %s "Q" = %s "Gain" = %s } }\n' "$i" "$label" "$fc" "$q" "$gain"
      printf '          { type = builtin name = b%d_r label = %s control = { "Freq" = %s "Q" = %s "Gain" = %s } }\n' "$i" "$label" "$fc" "$q" "$gain"
      i=$((i + 1))
    done < <(jq -r '.bands[] | [.type, .fc, .gain, .q] | @tsv' <<< "$json")

    cat <<H
        ]

        links = [
H
    if ((n > 0)); then
      echo '          { output = "pre_l:Out" input = "b0_l:In" }'
      echo '          { output = "pre_r:Out" input = "b0_r:In" }'
      local last=$((n - 1))
      for ((j = 0; j < last; j++)); do
        echo "          { output = \"b${j}_l:Out\" input = \"b$((j + 1))_l:In\" }"
        echo "          { output = \"b${j}_r:Out\" input = \"b$((j + 1))_r:In\" }"
      done
      echo "          # deck eq: $n bands"
    fi
    cat <<H
        ]

        inputs  = [ "pre_l:In" "pre_r:In" ]
H
    if ((n > 0)); then
      echo "        outputs = [ \"b$((n - 1))_l:Out\" \"b$((n - 1))_r:Out\" ]"
    else
      echo '        outputs = [ "pre_l:Out" "pre_r:Out" ]'
    fi
    cat <<H
      }

      audio.channels = 2
      audio.position = [ FL FR ]

      capture.props = {
        node.name   = "$SINK"
        media.class = Audio/Sink
      }
      playback.props = {
        node.name       = "$OUTPUT"
        node.passive    = true
        target.object   = "$target"
        node.dont-move  = true
        node.dont-fallback = true
        node.linger     = true
      }
    }
  }
]
H
  } > "$out"
}

write_unit() {
  local helper
  helper="$(readlink -f "$0")"
  cat > "$UNIT" <<U
[Unit]
Description=Deck headphone EQ filter-chain
Documentation=https://github.com/mutex-solutions/omarchy-audio
After=pipewire.service wireplumber.service
Requires=pipewire.service
Wants=wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c deck-eq.conf
# A service that starts from the boot graph must route too: the default sink
# and the application streams are not restored by the filter itself.
ExecStartPost=$helper route
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
U
}

app_streams() {
  pactl list sink-inputs 2>/dev/null | awk '
    /^Sink Input #/ { id = substr($3, 2) }
    /application\.name = / {
      app = $0
      sub(/.*application\.name = "/, "", app)
      sub(/"$/, "", app)
      if (app != "" && app != "Headphone EQ") print id
    }'
}

move_apps_to() {
  local target="$1" id
  for id in $(app_streams); do
    pactl move-sink-input "$id" "$target" 2>/dev/null || true
  done
}

sink_exists() { pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -qx "$SINK"; }
sink_volume_pct() { pactl get-sink-volume "$1" 2>/dev/null | awk 'match($0, /[0-9]+%/) {v=substr($0, RSTART, RLENGTH-1); print v; exit}'; }
sink_muted() { pactl get-sink-mute "$1" 2>/dev/null | awk '/Mute:/ {print ($2 == "yes" ? 1 : 0)}'; }

load_state() { [[ -r $STATE ]] && cat "$STATE" || echo '{"on":false}'; }
save_state() { printf '%s\n' "$1" > "$STATE"; }

last_profile() { jq -r '.profile // "Flat"' <<< "$(load_state)"; }

resolve_profile() {
  local want="$1" name="${2:-}" file
  if [[ $want =~ ^https?:// ]]; then
    if [[ -z $name ]]; then
      name="$(basename "${want%%\?*}")"
      name="${name//%20/ }"
      name="${name% ParametricEQ.txt}"
      name="${name%.txt}"
    fi
    name="${name//\//-}"
    [[ -n $name && $name != ParametricEQ ]] || name="Imported EQ"
    file="$PROFILE_DIR/$name.txt"
    curl -fsL --max-time 20 "$want" -o "$file" || fail "could not download $want"
    grep -q '^Filter' "$file" || { rm -f "$file"; fail "that file has no AutoEQ filter lines"; }
    printf '%s\n' "$file"
    return
  fi
  if [[ -f $want ]]; then printf '%s\n' "$want"; return; fi
  file="$PROFILE_DIR/$want.txt"
  [[ -f $file ]] || fail "no profile named $want"
  printf '%s\n' "$file"
}

# Values go straight into a PipeWire config, and a profile may come from a URL
# or a hand-built --bands-json. Out-of-range or non-numeric numbers would not
# fail here; they would fail as "the EQ sink did not appear". Clamp them to what
# a biquad EQ can sensibly be asked for, and drop unknown filter types.
sanitize_profile() {
  jq -c '
    def clamp($lo; $hi): if . < $lo then $lo elif . > $hi then $hi else . end;
    .preamp = ((.preamp | tonumber) | clamp(-30; 10))
    | .bands = ([.bands[:32][] | select((.type | IN("PK", "LS", "HS")))
        | {type: .type,
           fc:   ((.fc   | tonumber) | clamp(20; 20000)),
           gain: ((.gain | tonumber) | clamp(-30; 30)),
           q:    ((.q    | tonumber) | clamp(0.05; 20))}])
  ' <<< "$1" 2>/dev/null
}

start_eq() {
  local json profile="$2"
  # fail inside $( ) would only end the subshell and be captured as the value.
  json="$(sanitize_profile "$1")" || fail "that profile has values the EQ cannot use"
  local hardware
  hardware="$(pactl get-default-sink 2>/dev/null || true)"
  if [[ -z $hardware || $hardware == "$SINK" ]]; then
    hardware="$(jq -r '.hardware // empty' <<< "$(load_state)")"
  fi
  [[ -n $hardware ]] || fail "no output sink to put the EQ in front of"
  [[ -r $HOST_SRC ]] || fail "missing $HOST_SRC (Omarchy filter-chain host)"

  local hw_volume hw_mute user_volume user_mute prev_default prev_state
  prev_default="$(pactl get-default-sink 2>/dev/null || true)"
  prev_state="$(load_state)"
  if [[ $prev_default == "$SINK" ]]; then
    # Reapplying while on: the hardware is parked at 100% and the user's level
    # lives on the EQ sink. Keep both.
    hw_volume="$(jq -r '.hardwareVolume // 100' <<< "$prev_state")"
    hw_mute="$(jq -r '.hardwareMute // 0' <<< "$prev_state")"
    user_volume="$(sink_volume_pct "$SINK")"; [[ -n $user_volume ]] || user_volume=$hw_volume
    user_mute="$(sink_muted "$SINK")"; [[ -n $user_mute ]] || user_mute=$hw_mute
  else
    hw_volume="$(sink_volume_pct "$hardware")"; [[ -n $hw_volume ]] || hw_volume=100
    hw_mute="$(sink_muted "$hardware")"; [[ -n $hw_mute ]] || hw_mute=0
    user_volume=$hw_volume
    user_mute=$hw_mute
  fi

  systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
  cp "$HOST_SRC" "$HOST_CONF"
  render_fragment "$json" "$hardware" "$FRAG"
  write_unit
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  if ! systemctl --user enable --now "$SERVICE" >/dev/null 2>&1; then
    fail "deck-eq.service would not start: $(systemctl --user status "$SERVICE" --no-pager 2>&1 | tail -3 | tr '\n' ' ')"
  fi

  local i
  for i in {1..24}; do sink_exists && break; sleep 0.25; done
  sink_exists || {
    systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
    rm -f "$FRAG" "$HOST_CONF" "$UNIT"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    fail "the EQ sink did not appear"
  }

  # One volume, not two: move the user's level onto the EQ sink and leave the
  # hardware at full scale so the chain is not attenuated twice.
  pactl set-sink-volume "$hardware" 100% >/dev/null 2>&1 || true
  pactl set-sink-mute "$hardware" 0 >/dev/null 2>&1 || true
  pactl set-sink-volume "$SINK" "${user_volume}%" >/dev/null 2>&1 || true
  pactl set-sink-mute "$SINK" "$user_mute" >/dev/null 2>&1 || true
  pactl set-default-sink "$SINK" >/dev/null 2>&1 || true
  move_apps_to "$SINK"

  save_state "$(jq -c --arg profile "$profile" --arg hardware "$hardware" \
    --argjson hw_volume "$hw_volume" --argjson hw_mute "$hw_mute" \
    '. + {on:true, profile:$profile, hardware:$hardware,
          hardwareVolume:$hw_volume, hardwareMute:$hw_mute, updated:(now|todate)}' <<< "$json")"
}

stop_eq() {
  local st hardware hw_volume hw_mute
  st="$(load_state)"
  hardware="$(jq -r '.hardware // empty' <<< "$st")"
  hw_volume="$(jq -r '.hardwareVolume // empty' <<< "$st")"
  hw_mute="$(jq -r '.hardwareMute // empty' <<< "$st")"
  systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
  if [[ -n $hardware ]]; then
    pactl set-default-sink "$hardware" >/dev/null 2>&1 || true
    move_apps_to "$hardware"
    [[ -n $hw_volume ]] && pactl set-sink-volume "$hardware" "${hw_volume}%" >/dev/null 2>&1 || true
    [[ -n $hw_mute ]] && pactl set-sink-mute "$hardware" "$hw_mute" >/dev/null 2>&1 || true
  fi
  save_state "$(jq -c '. + {on:false, updated:(now|todate)}' <<< "$st")"
}

status_json() {
  local st
  st="$(load_state)"
  jq -c --arg sink "$SINK" --argjson sinkUp "$(sink_exists && echo true || echo false)" '
    . + {sink:$sink, sinkUp:$sinkUp}' <<< "$st"
}

case "${1:-status}" in
  route)
    st="$(load_state)"
    [[ "$(jq -r '.on // false' <<< "$st")" == true ]] || { status_json; exit 0; }
    hardware="$(jq -r '.hardware // empty' <<< "$st")"
    [[ -n $hardware ]] || fail "the EQ state has no hardware sink"
    for i in {1..24}; do sink_exists && break; sleep 0.25; done
    sink_exists || fail "the EQ sink did not appear"
    hw_volume="$(jq -r '.hardwareVolume // 100' <<< "$st")"
    hw_mute="$(jq -r '.hardwareMute // 0' <<< "$st")"
    pactl set-sink-volume "$hardware" 100% >/dev/null 2>&1 || true
    pactl set-sink-mute "$hardware" 0 >/dev/null 2>&1 || true
    pactl set-sink-volume "$SINK" "${hw_volume}%" >/dev/null 2>&1 || true
    pactl set-sink-mute "$SINK" "$hw_mute" >/dev/null 2>&1 || true
    pactl set-default-sink "$SINK" >/dev/null 2>&1 || true
    move_apps_to "$SINK"
    status_json ;;

  status) status_json ;;

  list)
    jq -R -s -c 'split("\n") | map(select(length>0) | {name:(sub("\\.txt$";"")), file:.})' \
      < <(find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.txt' -printf '%f\n' | sort) ;;

  apply)
    want="${2:-}"; [[ -n $want ]] || fail "usage: audio-eq apply <profile|url>"
    shift 2
    pre=""; gains=""; bands_json=""; as_name=""
    while (($#)); do
      case "$1" in
        --preamp) pre="${2:?}"; shift 2 ;;
        --gains) gains="${2:-}"; shift 2 ;;
        --bands-json) bands_json="${2:?}"; shift 2 ;;
        --as) as_name="${2:?}"; shift 2 ;;
        *) fail "unknown option $1" ;;
      esac
    done
    file="$(resolve_profile "$want" "$as_name")"
    profile="$(name_of "$file")"
    json="$(parse_profile "$file" "$profile")"
    if [[ -n $pre ]]; then json="$(jq -c --argjson p "$pre" '.preamp=$p' <<< "$json")"; fi
    if [[ -n $gains ]]; then
      json="$(jq -c --arg g "$gains" '
        ($g | split(",") | map(tonumber? // null)) as $g
        | .bands = ([.bands[] | .] | to_entries
          | map(.value + {gain: (if $g[.key] == null then .value.gain else $g[.key] end)}))
      ' <<< "$json")"
    fi
    if [[ -n $bands_json ]]; then
      json="$(jq -c --argjson b "$bands_json" '
        .bands = ($b | map({
          type: ((.type // "PK") | tostring),
          fc: ((.fc // 1000) | tonumber),
          gain: ((.gain // 0) | tonumber),
          q: ((.q // 0.707) | tonumber)
        }))' <<< "$json")" || fail "--bands-json is not a valid band array"
    fi
    start_eq "$json" "$profile"
    status_json ;;

  on)
    file="$(resolve_profile "$(last_profile)")"
    json="$(parse_profile "$file" "$(name_of "$file")")"
    start_eq "$json" "$(name_of "$file")"
    status_json ;;

  off) stop_eq; status_json ;;

  toggle)
    if [[ "$(jq -r '.on // false' <<< "$(load_state)")" == true ]]; then
      stop_eq
    else
      file="$(resolve_profile "$(last_profile)")"
      json="$(parse_profile "$file" "$(name_of "$file")")"
      start_eq "$json" "$(name_of "$file")"
    fi
    status_json ;;

  import)
    want="${2:-}"; [[ -n $want ]] || fail "usage: audio-eq import <url|path> [name]"
    name="${3:-}"
    if [[ $want =~ ^https?:// ]]; then
      tmp="$(mktemp)"
      curl -fsL --max-time 20 "$want" -o "$tmp" || fail "could not download $want"
      [[ -n $name ]] || name="$(basename "${want%%\?*}" .txt)"
      [[ -n $name ]] || name="Imported EQ"
      grep -q '^Filter' "$tmp" || { rm -f "$tmp"; fail "that file has no AutoEQ filter lines"; }
      mv "$tmp" "$PROFILE_DIR/$name.txt"
    else
      [[ -r $want ]] || fail "no such file: $want"
      [[ -n $name ]] || name="$(name_of "$want")"
      cp "$want" "$PROFILE_DIR/$name.txt"
    fi
    jq -nc --arg name "$name" --arg file "$PROFILE_DIR/$name.txt" \
      '{ok:true, imported:$name, file:$file}' ;;

  search)
    q="${2:-}"; [[ -n $q ]] || fail "usage: audio-eq search <query>"
    ensure_sources
    mkdir -p "$INDEX_DIR"
    # Build whatever is missing or a week old; a source that cannot be reached
    # costs its own results and is reported, not the whole search.
    failed=()
    while IFS= read -r id; do
      f="$INDEX_DIR/$id.json"
      if [[ ! -s $f ]] || [[ $(find "$f" -mtime +7 2>/dev/null) ]]; then
        build_index "$id" >/dev/null 2>&1 || failed+=("$id")
      fi
    done < <(jq -r '.[] | select(.enabled) | .id' "$SOURCES")
    files=()
    while IFS= read -r id; do
      [[ -s $INDEX_DIR/$id.json ]] && files+=("$INDEX_DIR/$id.json")
    done < <(jq -r '.[] | select(.enabled) | .id' "$SOURCES")
    [[ ${#files[@]} -gt 0 ]] || fail "no source could be read; check Manage sources"
    jq -c -s --arg q "$(tr '[:upper:]' '[:lower:]' <<< "$q")" --argjson failed "$(printf '%s\n' "${failed[@]:-}" | jq -R . | jq -sc 'map(select(length>0))')" '
      ($q | split(" ") | map(select(length > 0))) as $t
      | (add // []) as $all
      | { failed: $failed,
          results: [ $all[]
            | ((.name + " " + .provider + " " + .category + " " + .sourceName) | ascii_downcase) as $h
            | select($t | all(. as $w | $h | contains($w)))
            | . + {rank: (if ((.name|ascii_downcase) | startswith($t[0])) then 0 else 1 end)} ]
          | sort_by(.rank, .name) | .[:400] | map(del(.rank)) }' "${files[@]}" ;;

  sources) ensure_sources; sources_json ;;

  source-add)
    kind="${2:-}"; target="${3:-}"; name="${4:-}"
    [[ -n $kind && -n $target ]] || fail "usage: audio-eq source-add <github|json|folder> <target> [name]"
    case "$kind" in
      github)
        target="${target#https://github.com/}"; target="${target%/}"; target="${target%.git}"
        [[ $target =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(@[A-Za-z0-9_./-]+)?$ ]] \
          || fail "a GitHub source looks like owner/repo or owner/repo@branch" ;;
      json) [[ $target =~ ^https?:// ]] || fail "a JSON source needs an http(s) address" ;;
      folder) target="${target/#\~/$HOME}"; [[ -d $target ]] || fail "no such folder: $target" ;;
      *) fail "source kind must be github, json or folder" ;;
    esac
    ensure_sources
    [[ -n $name ]] || name="$(basename "${target%%@*}")"
    id="$(tr '[:upper:] ' '[:lower:]-' <<< "$name" | tr -cd 'a-z0-9-')"
    [[ -n $id ]] || id="source"
    base="$id"; n=2
    while jq -e --arg id "$id" 'any(.[]; .id == $id)' "$SOURCES" >/dev/null; do id="$base-$n"; n=$((n+1)); done
    save_sources "$(jq -c --arg id "$id" --arg name "$name" --arg kind "$kind" --arg target "$target" \
      '. + [{id:$id, name:$name, kind:$kind, target:$target, enabled:true, builtin:false}]' "$SOURCES")"
    if ! err="$(build_index "$id" 2>&1)"; then
      save_sources "$(jq -c --arg id "$id" 'map(select(.id != $id))' "$SOURCES")"
      rm -f "$INDEX_DIR/$id.json"
      fail "${err:-that source has no profiles I can read}"
    fi
    sources_json ;;

  source-remove)
    id="${2:-}"; ensure_sources
    jq -e --arg id "$id" 'any(.[]; .id == $id and (.builtin | not))' "$SOURCES" >/dev/null \
      || fail "no removable source named $id"
    save_sources "$(jq -c --arg id "$id" 'map(select(.id != $id))' "$SOURCES")"
    rm -f "$INDEX_DIR/$id.json"
    sources_json ;;

  source-enable)
    id="${2:-}"; val="${3:-}"; ensure_sources
    [[ $val == on || $val == off ]] || fail "usage: audio-eq source-enable <id> on|off"
    jq -e --arg id "$id" 'any(.[]; .id == $id)' "$SOURCES" >/dev/null || fail "no source named $id"
    save_sources "$(jq -c --arg id "$id" --argjson on "$([[ $val == on ]] && echo true || echo false)" \
      'map(if .id == $id then .enabled = $on else . end)' "$SOURCES")"
    sources_json ;;

  source-refresh)
    ensure_sources
    ids="${2:-}"
    [[ -n $ids ]] || ids="$(jq -r '.[] | select(.enabled) | .id' "$SOURCES")"
    for id in $ids; do build_index "$id" >/dev/null 2>&1 || true; done
    sources_json ;;

  *) fail "usage: audio-eq status|list|apply|on|off|toggle|import|search|sources|source-*" ;;
esac
